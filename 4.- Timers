"""Este código que envía una señal cuadrada de 500 Hz con un PWM de 
50% por la patilla PB5, será utilizando las direcciones de los diversos
registros a utilizar.
Se utilizará el TC0. Sin utilizar nombres que presenten 
abstracción de los registros, solo números."""

;Calculo de la rutina.  DelayRoutine = (Tosc * FactorPreescalacion )(256)
; a 16 MHz.  DelayRoutine = (62.5 ns * 64) * 256 = 1.024 ms lo que equivace a un periodo de apox 2 ms 
, que es una frecuencia de 500 Hz


.include <m328pdef.inc>
.org 0 ; Vector reset en la direccion 0 
rjmp inicio 
org 0x60 ; Code section start 
inicio:
    sbi 0x04,5 ; Pone a 1 el pin 5 de DDRB (pin5 del PORTB como salida)
    ldi r16,0X03 ; Prescalador = 64
    out 0x25,r16 ; Se escribe directamente a TCCR0B — se arranca el TC0. 
init: 
    sbi 0x05,5 
    rcall DelaySubrutina 
    cbi 0x05,5 
    rcall DelaySubrutina 
    rjmp init 
DelaySubrutina: 
    in r16, 0x15 ; Leer el status del bit de sobreflujo del TC0, este es TOV0 (bit 0 de TIFR0)
    sbrs r16, 0 ; Salta si la flag de sobreflujo se activo (es 1). 
rjmp DelaySubrutina 
    ldi r16,1 
    out 0x15, r16 ; Resetear la bandera de sobreflujo escribiendo un 1 
    ret ; Retorna del llamado de la rutina.
